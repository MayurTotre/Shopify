<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Shopify" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dark_grey</item>
        <item name="color">@color/grey</item>
        <item name="colorAccent">@color/light_grey</item>
        <item name="colorButtonNormal">@color/darkest_grey</item>
    </style>
    
    <style name="Theme.Shopify" parent="Base.Theme.Shopify" />

    <style name="Theme.MyApp.SplashScreen" parent="Theme.SplashScreen">
